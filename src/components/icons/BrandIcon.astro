---
// Brand marks are not part of Lucide, so they are drawn here as simple
// single-colour glyphs that inherit `currentColor`.
export type BrandName = 'whatsapp' | 'instagram' | 'tiktok' | 'facebook';

interface Props {
  name: BrandName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'whatsapp' && (
      <>
        <path
          d="M3.6 20.4l1.2-4.1a8.4 8.4 0 1 1 3.2 3.1z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linejoin="round"
        />
        <path
          fill="currentColor"
          d="M9.1 8.5c0-.4.3-.7.7-.7h.6c.3 0 .5.2.6.4l.6 1.5c.1.3 0 .6-.2.8l-.5.5a5.6 5.6 0 0 0 2.6 2.6l.5-.5c.2-.2.5-.3.8-.2l1.5.6c.3.1.4.3.4.6v.6c0 .4-.3.7-.7.7a6.9 6.9 0 0 1-6.9-6.9z"
        />
      </>
    )
  }
  {
    name === 'instagram' && (
      <g fill="none" stroke="currentColor" stroke-width="1.7">
        <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5" />
        <circle cx="12" cy="12" r="4.1" />
        <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
      </g>
    )
  }
  {
    name === 'tiktok' && (
      <path
        fill="currentColor"
        d="M16.6 3h-3.1v12.2a2.6 2.6 0 1 1-2.6-2.6c.3 0 .5 0 .8.1V9.5a5.8 5.8 0 1 0 5 5.7V9.1a7.3 7.3 0 0 0 4.3 1.4V7.4a4.3 4.3 0 0 1-4.4-4.4z"
      />
    )
  }
  {
    name === 'facebook' && (
      <path
        fill="currentColor"
        d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21z"
      />
    )
  }
</svg>

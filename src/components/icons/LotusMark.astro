---
// The lotus from the brand's printed material, redrawn as a line mark.
interface Props {
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { size = 32, class: className, strokeWidth = 1.4 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 40"
  width={size}
  height={(size * 40) / 48}
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M24 4c4.6 5.2 6.8 10.4 6.8 15.6S28.6 28.8 24 32c-4.6-3.2-6.8-7.2-6.8-12.4S19.4 9.2 24 4z" />
  <path d="M17.6 14.4C12.8 13 8.4 13 4.8 14c.4 6.4 3.6 12 9.2 15.4 3 1.8 6.4 2.6 10 2.6" />
  <path d="M30.4 14.4c4.8-1.4 9.2-1.4 12.8-.4-.4 6.4-3.6 12-9.2 15.4-3 1.8-6.4 2.6-10 2.6" />
  <path d="M10 36h28" />
</svg>

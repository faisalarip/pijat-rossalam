---
import { Image } from 'astro:assets';
import { Building, Clock, House } from '@lucide/astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { audiences, serviceModes, services } from '../data/business';
import { formatDuration } from '../lib/format';

const modeIcons = { incall: Building, outcall: House } as const;
---

<section id="layanan" class="section bg-linen" aria-labelledby="layanan-title">
  <div class="container-page">
    <!-- MARK: Intro + ways to book -->
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 id="layanan-title">Layanan kami</h2>
        <p class="lede mt-6">
          Pilih perawatan yang Anda butuhkan. Durasi tertera untuk setiap layanan; harga dan
          jadwal kami konfirmasi langsung lewat WhatsApp.
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 lg:col-span-7 lg:pt-2">
        {
          serviceModes.map((mode) => {
            const Icon = modeIcons[mode.id];
            return (
              <div class="border-t border-espresso/20 pt-6">
                <Icon size={26} stroke-width={1.5} class="text-sage-deep" aria-hidden="true" />
                <h3 class="mt-4 text-[1.4rem]">{mode.title}</h3>
                <p class="mt-2 text-espresso/80">{mode.description}</p>
              </div>
            );
          })
        }
        <div class="sm:col-span-2">
          <p class="text-sm text-walnut">Sering dipesan oleh</p>
          <ul class="mt-3 flex flex-wrap gap-2" aria-label="Pelanggan kami">
            {
              audiences.map((audience) => (
                <li class="rounded-full border border-espresso/15 px-4 py-1.5 text-sm text-espresso/85">
                  {audience}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- MARK: Treatments -->
    <ul class="mt-20 grid gap-x-10 gap-y-16 md:grid-cols-2" role="list">
      {
        services.map((service) => (
          <li class="flex flex-col">
            <article class="flex flex-1 flex-col" aria-labelledby={`service-${service.id}`}>
              <div class="overflow-hidden rounded-[3px]">
                <Image
                  src={service.image.src}
                  alt={service.image.alt}
                  widths={[480, 720, 960, 1200]}
                  sizes="(min-width: 768px) 46vw, 92vw"
                  class="aspect-[3/2] w-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="mt-6 flex items-baseline justify-between gap-4">
                <h3 id={`service-${service.id}`} class="text-[1.85rem]">
                  {service.name}
                </h3>
                {service.price && <p class="font-semibold text-sage-deep">{service.price}</p>}
              </div>
              {service.durationMinutes && (
                <p class="mt-2 flex items-center gap-2 text-sm text-walnut">
                  <Clock size={16} aria-hidden="true" />
                  <span>{formatDuration(service.durationMinutes)}</span>
                </p>
              )}
              <p class="mt-4 max-w-prose flex-1 text-espresso/85">{service.description}</p>
              <WhatsAppButton
                label="Pesan layanan ini"
                serviceName={service.name}
                placement="service_card"
                variant="link"
                class="mt-5 self-start"
              />
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

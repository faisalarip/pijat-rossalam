---
import { HandHeart, Leaf, ShieldCheck, Users } from '@lucide/astro';
import LotusMark from './icons/LotusMark.astro';
import { business, highlights, type HighlightIcon } from '../data/business';

const icons: Record<Exclude<HighlightIcon, 'heritage'>, typeof Leaf> = {
  therapist: HandHeart,
  privacy: ShieldCheck,
  clean: Leaf,
  family: Users,
};
---

<section class="section on-dark bg-espresso text-ivory" aria-labelledby="keunggulan-title">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-12">
      <h2 id="keunggulan-title" class="lg:col-span-5">
        Kenapa memilih {business.shortName}
      </h2>
      <p class="text-lg leading-relaxed text-ivory/80 lg:col-span-6 lg:col-start-7 lg:pt-3">
        Kami tidak menjanjikan hal yang berlebihan. Yang kami tawarkan sederhana: pijatan yang
        baik, tempat yang bersih, dan pelayanan yang membuat Anda ingin datang lagi.
      </p>
    </div>

    <ul class="mt-16 grid border-t border-ivory/15 sm:grid-cols-2 lg:grid-cols-5" role="list">
      {
        highlights.map((item) => {
          const Icon = item.icon === 'heritage' ? null : icons[item.icon];
          return (
            <li class="border-b border-ivory/15 py-8 sm:pr-8 lg:border-b-0 lg:border-l lg:px-6 lg:first:border-l-0 lg:first:pl-0">
              {Icon ? (
                <Icon size={28} stroke-width={1.4} class="text-brass" aria-hidden="true" />
              ) : (
                <LotusMark size={34} class="text-brass" />
              )}
              <h3 class="mt-5 text-xl leading-snug">{item.title}</h3>
              <p class="mt-3 text-[0.975rem] leading-relaxed text-ivory/75">{item.text}</p>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

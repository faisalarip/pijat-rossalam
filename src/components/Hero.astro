---
import { Picture } from 'astro:assets';
import { Clock, House } from '@lucide/astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { branches, business, heroImage } from '../data/business';
import { formatHours } from '../lib/format';

const mainHours = branches[0]?.hours[0];
---

<section id="beranda" class="on-dark relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-espresso text-ivory">
  <!-- MARK: Photo (LCP element: eager, high priority, responsive) -->
  <Picture
    src={heroImage.src}
    alt={heroImage.alt}
    formats={['avif', 'webp']}
    widths={[640, 960, 1280, 1680, 2200]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[62%_center]"
    pictureAttributes={{ class: 'contents' }}
  />
  <div class="hero-scrim absolute inset-0 -z-10" aria-hidden="true"></div>

  <!-- MARK: Copy -->
  <div class="container-page flex flex-1 flex-col justify-end pt-32 pb-12 sm:pb-16 lg:justify-center lg:pt-24">
    <div class="max-w-5xl">
      <p class="settle mb-6 flex items-center gap-3 text-sm text-ivory/85 sm:text-base">
        <span class="h-px w-10 bg-brass" aria-hidden="true"></span>
        {business.name}, berdiri {business.establishedYear}
      </p>

      <h1 class="settle settle-delay-1 text-[clamp(2.9rem,8.4vw,6.25rem)]">
        {business.motto}
      </h1>

      <p class="settle settle-delay-2 mt-6 font-display text-xl text-ivory/95 sm:text-2xl">
        Pijat & refleksi keluarga terpercaya sejak {business.establishedYear}.
      </p>
      <p class="settle settle-delay-2 mt-4 max-w-xl text-ivory/85 sm:text-lg">
        Terapis kami merawat lelah Anda dengan pijatan yang tenang dan terukur, di tempat praktik
        kami di Mampang Prapatan atau langsung di rumah Anda.
      </p>

      <div class="settle settle-delay-3 mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <WhatsAppButton label="Pesan via WhatsApp" placement="hero" variant="light" />
        <a href="#layanan" class="btn btn-outline-light">Lihat Layanan</a>
      </div>
    </div>
  </div>

  <!-- MARK: Practical facts -->
  <div class="border-t border-ivory/20">
    <div class="container-page grid gap-x-10 gap-y-3 py-5 text-sm text-ivory/90 sm:grid-cols-2 sm:text-[0.95rem] lg:flex">
      {
        mainHours && (
          <p class="flex items-center gap-3">
            <Clock size={18} class="shrink-0 text-brass" aria-hidden="true" />
            Buka {mainHours.label.toLowerCase()}, {formatHours(mainHours)}
          </p>
        )
      }
      <p class="flex items-center gap-3">
        <House size={18} class="shrink-0 text-brass" aria-hidden="true" />
        Datang ke tempat kami, atau panggil terapis ke rumah, hotel & apartemen
      </p>
    </div>
  </div>
</section>

<style>
  /* One scrim keeps the copy readable over any replacement photo. */
  .hero-scrim {
    background:
      linear-gradient(to top, rgb(43 33 27 / 0.92) 0%, rgb(43 33 27 / 0.55) 45%, rgb(43 33 27 / 0.25) 100%),
      linear-gradient(to right, rgb(43 33 27 / 0.55), transparent 70%);
  }
</style>

---
import { Image } from 'astro:assets';
import LotusMark from './icons/LotusMark.astro';
import { aboutImages, business } from '../data/business';
---

<section id="tentang" class="section" aria-labelledby="tentang-title">
  <div class="container-page grid items-center gap-14 lg:grid-cols-12 lg:gap-16">
    <!-- MARK: Photo pair -->
    <div class="relative lg:col-span-6">
      <Image
        src={aboutImages.primary.src}
        alt={aboutImages.primary.alt}
        widths={[480, 720, 960, 1200]}
        sizes="(min-width: 1024px) 40vw, 85vw"
        class="aspect-[4/5] w-[85%] rounded-[3px] object-cover"
        loading="lazy"
      />
      <Image
        src={aboutImages.secondary.src}
        alt={aboutImages.secondary.alt}
        widths={[320, 480, 640]}
        sizes="(min-width: 1024px) 20vw, 45vw"
        class="absolute right-0 bottom-[-2.5rem] aspect-square w-[45%] rounded-[3px] border-[6px] border-ivory object-cover"
        loading="lazy"
      />
    </div>

    <!-- MARK: Story -->
    <div class="lg:col-span-6 lg:pl-4">
      <h2 id="tentang-title">Tradisi relaksasi sejak {business.establishedYear}</h2>
      <div class="mt-8 space-y-5 text-lg leading-relaxed text-espresso/85">
        <p>
          {business.name} mulai melayani pijat dan refleksi pada tahun {business.establishedYear}.
          Sejak itu kami merawat perorangan maupun keluarga: orang tua yang ingin melepas pegal,
          pekerja yang butuh jeda dari meja kantor, hingga tamu yang singgah di Jakarta.
        </p>
        <p>
          Yang kami jaga sejak awal tetap sama: sambutan yang ramah, ruangan yang bersih dan tenang,
          serta terapis terlatih yang mendengarkan kebutuhan Anda sebelum mulai memijat.
        </p>
      </div>

      <!-- Heritage highlight -->
      <figure class="mt-12 flex items-center gap-6 border-y border-sand py-7">
        <LotusMark size={52} class="shrink-0 text-brass" strokeWidth={1.2} />
        <figcaption>
          <span class="block font-display text-4xl leading-none text-espresso">
            {business.establishedYear}
          </span>
          <span class="mt-2 block text-walnut">
            Lebih dari dua dekade menemani keluarga Jakarta beristirahat.
          </span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

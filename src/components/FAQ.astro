---
import { Plus } from '@lucide/astro';
import { faq } from '../data/business';
---

<section class="section bg-linen" aria-labelledby="faq-title">
  <div class="container-page grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h2 id="faq-title">Pertanyaan yang sering diajukan</h2>
      <p class="mt-5 text-walnut">
        Belum menemukan jawabannya? Tanyakan langsung lewat WhatsApp.
      </p>
    </div>

    <!-- MARK: Accordion
         Native <details>/<summary>: keyboard and screen-reader support
         without JavaScript. -->
    <div class="border-t border-espresso/20 lg:col-span-7 lg:col-start-6">
      {
        faq.map((item) => (
          <details class="faq-item group border-b border-espresso/20">
            <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 py-5 text-left">
              <h3 class="font-sans text-lg font-semibold leading-snug">{item.question}</h3>
              <Plus
                size={22}
                aria-hidden="true"
                class="shrink-0 text-sage-deep transition-transform duration-300 group-open:rotate-45"
              />
            </summary>
            <p class="max-w-prose pb-6 leading-relaxed text-espresso/80">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary:hover h3 {
    color: var(--color-sage-deep);
  }
</style>

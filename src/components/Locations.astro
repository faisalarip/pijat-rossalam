---
import { Clock, MapPin, Navigation, Car } from '@lucide/astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { branches } from '../data/business';
import { addressLines, directionsUrl, formatHours, mapEmbedUrl } from '../lib/format';
import { track } from '../lib/analytics';
---

<section id="lokasi" class="section" aria-labelledby="lokasi-title">
  <div class="container-page">
    <h2 id="lokasi-title">{branches.length > 1 ? 'Lokasi cabang kami' : 'Lokasi kami'}</h2>
    <p class="lede mt-5">
      Kunjungi tempat praktik kami, atau minta terapis datang ke alamat Anda.
    </p>

    <ul class="mt-12 space-y-16" role="list">
      {
        branches.map((branch) => (
          <li class="grid gap-10 lg:grid-cols-12 lg:gap-14">
            <!-- MARK: Branch details -->
            <div class="lg:col-span-5">
              <h3 class="text-[1.9rem]">{branch.name}</h3>
              <dl class="mt-8 space-y-6">
                <div class="flex gap-4">
                  <dt class="pt-1">
                    <MapPin size={20} class="text-sage-deep" aria-hidden="true" />
                    <span class="sr-only">Alamat</span>
                  </dt>
                  <dd>
                    <address class="not-italic leading-relaxed">
                      {addressLines(branch.address).map((line) => (
                        <span class="block">{line}</span>
                      ))}
                    </address>
                  </dd>
                </div>
                <div class="flex gap-4">
                  <dt class="pt-1">
                    <Clock size={20} class="text-sage-deep" aria-hidden="true" />
                    <span class="sr-only">Jam buka</span>
                  </dt>
                  <dd>
                    {branch.hours.map((hours) => (
                      <span class="block">
                        {hours.label}, {formatHours(hours)} WIB
                      </span>
                    ))}
                  </dd>
                </div>
                {branch.serviceArea && (
                  <div class="flex gap-4">
                    <dt class="pt-1">
                      <Car size={20} class="text-sage-deep" aria-hidden="true" />
                      <span class="sr-only">Layanan panggilan</span>
                    </dt>
                    <dd>{branch.serviceArea}</dd>
                  </div>
                )}
              </dl>

              <div class="mt-10 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
                <a
                  href={directionsUrl(branch)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-outline"
                  {...track('directions_click', { branch: branch.name, placement: 'locations' })}
                >
                  <Navigation size={18} aria-hidden="true" />
                  Petunjuk arah
                  <span class="sr-only">(Google Maps, tab baru)</span>
                </a>
                <WhatsAppButton
                  label="Chat cabang ini"
                  branch={branch}
                  placement="locations"
                />
              </div>
            </div>

            <!-- MARK: Map (click-to-load: no Google requests until asked) -->
            <div class="lg:col-span-7">
              <div
                class="relative aspect-[4/3] overflow-hidden rounded-[3px] bg-linen sm:aspect-[16/10]"
                data-map
                data-map-src={mapEmbedUrl(branch)}
                data-map-title={`Peta lokasi ${branch.name}`}
              >
                <div class="map-pattern absolute inset-0" aria-hidden="true" />
                <div class="relative flex h-full flex-col items-center justify-center gap-5 p-6 text-center">
                  <span class="flex size-14 items-center justify-center rounded-full bg-ivory text-sage-deep shadow-[0_1px_0_var(--color-sand)]">
                    <MapPin size={26} aria-hidden="true" />
                  </span>
                  <p class="max-w-xs text-walnut">
                    {branch.address.locality}, {branch.address.city}
                  </p>
                  <button type="button" class="btn btn-primary" data-map-load>
                    Tampilkan peta
                  </button>
                  <p class="text-xs text-walnut/90">Peta dimuat dari Google Maps.</p>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Quiet street-grid texture behind the map placeholder. */
  .map-pattern {
    background-image:
      linear-gradient(var(--color-sand) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-sand) 1px, transparent 1px);
    background-size: 44px 44px;
    opacity: 0.45;
    mask-image: radial-gradient(circle at center, black 20%, transparent 75%);
  }
</style>

<script>
  // MARK: - Map facade
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((container) => {
    const button = container.querySelector<HTMLButtonElement>('[data-map-load]');
    button?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = container.dataset.mapSrc ?? '';
      iframe.title = container.dataset.mapTitle ?? 'Peta lokasi';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.className = 'absolute inset-0 h-full w-full border-0';
      iframe.setAttribute('allowfullscreen', '');
      container.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

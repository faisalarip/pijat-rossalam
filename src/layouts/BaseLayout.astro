---
import { withBase } from '../lib/paths';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import displayFont from '@fontsource/marcellus/files/marcellus-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { business, heroImage, seo } from '../data/business';
import { localBusinessSchema } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  /** Transparent header over a full-bleed hero (home page only). */
  overlayHeader?: boolean;
  /** Emit LocalBusiness structured data (home page only). */
  structuredData?: boolean;
  noindex?: boolean;
}

const {
  title = seo.title,
  description = seo.description,
  overlayHeader = false,
  structuredData = false,
  noindex = false,
} = Astro.props;

// MARK: - URLs
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, siteUrl).href;

// 1200×630 social preview generated from the hero photo at build time.
const ogImage = await getImage({
  src: heroImage.src,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 80,
});
const ogImageUrl = new URL(ogImage.src, siteUrl).href;
const homeUrl = new URL(withBase('/'), siteUrl);
const schema = structuredData ? localBusinessSchema(homeUrl, ogImageUrl) : null;
---

<!doctype html>
<html lang={seo.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#2b211b" />

    <!-- MARK: Icons -->
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />

    <!-- MARK: Fonts (headline face preloaded to avoid a late swap in the hero) -->
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />

    <!-- MARK: Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={heroImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only z-[70] rounded-full bg-espresso px-5 py-3 text-ivory focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Langsung ke konten
    </a>
    <Header overlay={overlayHeader} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    <slot name="after-footer" />
    <Analytics />
  </body>
</html>

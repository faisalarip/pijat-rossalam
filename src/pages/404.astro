---
import { withBase } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import LotusMark from '../components/icons/LotusMark.astro';
import { business } from '../data/business';
---

<BaseLayout title={`Halaman tidak ditemukan | ${business.name}`} noindex>
  <section class="container-page flex min-h-[80svh] flex-col items-start justify-center pt-32 pb-20">
    <LotusMark size={48} class="text-brass" />
    <h1 class="mt-8 text-[clamp(2.5rem,6vw,4.5rem)]">Halaman ini tidak ditemukan.</h1>
    <p class="lede mt-5">
      Tautan mungkin sudah berubah. Kembali ke beranda, atau langsung pesan lewat WhatsApp.
    </p>
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a href={withBase('/')} class="btn btn-outline">Ke beranda</a>
      <WhatsAppButton placement="not_found" />
    </div>
  </section>
</BaseLayout>

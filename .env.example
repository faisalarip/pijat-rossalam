# Production domain, used for canonical URLs, Open Graph and the sitemap.
# astro.config.mjs reads this from the real environment, not from .env:
# set it in the hosting dashboard, or run `SITE_URL=https://... npm run build`.
SITE_URL=https://www.example.com

# Google Analytics 4 measurement ID. Leave empty to disable analytics entirely.
PUBLIC_GA_MEASUREMENT_ID=
